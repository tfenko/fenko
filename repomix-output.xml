    ]
  },
  halfreal: {
    title: "Half Real",
    audioSrc: "/Half-Real.mp3",
    coverSrc: "/halfreal-2.webp",
    bgGradient: "radial-gradient(circle at center, #1a0808 0%, #050101 100%)",
    links: [
      { name: 'Spotify', url: 'https://open.spotify.com/track/6UOYiUahxxA4wWBawrfmzY' },
