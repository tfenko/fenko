/* ==========================================
   ГОЛОВНИЙ ОВЕРЛЕЙ
========================================== */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px; 
  padding: 2rem 40px;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #000000;
}

.closeBtnOverlay {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  z-index: 999999;
  font-family: monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  padding: 8px 16px;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  cursor: pointer;
  transition: all 0.3s ease;
}

.closeBtnOverlay:hover {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.3);
}

/* ==========================================
   КОНТЕЙНЕР ЛІРИКИ
========================================== */
.lyricsContainer {
  flex: 1.4;
  max-width: 750px;
  height: 75vh;
  z-index: 5;
  pointer-events: auto;
}

.lyricsScroll {
  width: 100%;
  height: 100%;
  overflow-y: auto;
  padding: 35vh 0;
  padding-left: 10px;
  scrollbar-width: none;
  position: relative;
  mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
}

.lyricsScroll::-webkit-scrollbar {
  display: none;
}

.lyricLine {
  margin: 0;
  padding: 0;
  font-family: sans-serif;
  font-size: 26px;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 2.2rem;
  color: #ffffff;
  opacity: 0.15;
  transition: all 0.4s ease;
  cursor: pointer;
  white-space: normal; 
  word-wrap: break-word;
  transform-origin: left center;
}

.lyricLine:hover {
  opacity: 0.5;
}

.lyricLineActive {
  opacity: 1;
  transform: scale(1.03);
  text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
}

/* ==========================================
   СТУДІЙНА КАРТКА ПЛЕЄРА
========================================== */
.musicCard {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.05);
  padding: 24px;
  border-radius: 16px;
  backdrop-filter: blur(20px);
  width: 320px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  z-index: 10;
  flex-shrink: 0;
}

.coverWrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
}

.squareCover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.coverOverlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.3s ease;
}

.coverWrapper:hover .coverOverlay {
  opacity: 1;
}

.playIconContainer {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.metaBlock {
  margin-top: 1.2rem;
  text-align: left;
}

.trackTitle {
  font-family: sans-serif;
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
  margin: 0;
}

.artistName {
  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  color: rgba(255, 255, 255, 0.4);
  margin: 4px 0 0 0;
  text-transform: uppercase;
}

.platformsGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 1.2rem;
}

.platformBadge {
  font-family: monospace;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 8px;
  border-radius: 6px;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.platformBadge:hover {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.02);
}

.volumeBlock {
  margin-top: 1.2rem;
  width: 100%;
}

.volumeSlider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 2px;
  background: rgba(255, 255, 255, 0.1);
  outline: none;
  cursor: pointer;
}

.volumeSlider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ffffff;
}

/* ==========================================
   АДАПТИВНІСТЬ ТА МОБІЛЬНА ОПТИМІЗАЦІЯ
========================================== */
@media (max-width: 900px) {
  .overlay {
    flex-direction: column;
    padding: 1.5rem;
    padding-top: 2rem;
    padding-bottom: 5rem; /* Запас для кнопки знизу */
    justify-content: flex-start;
    gap: 1rem;
    overflow-y: auto;
  }
  
  /* Переміщуємо кнопку вниз */
  .closeBtnOverlay {
    position: fixed;
    top: auto;
    bottom: 20px;
    right: 50%;
    transform: translateX(50%);
    width: auto;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  }
  
  .musicCard {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    padding: 16px;
    order: -1;
  }
  
  .lyricsContainer {
    width: 100%;
    height: auto;
    min-height: 40vh;
  }
  
  .lyricsScroll {
    padding: 10vh 0;
  }
  
  .lyricLine {
    font-size: 20px;
    margin-bottom: 2rem;
  }
}
