    >
      {/* ✅ ТВОЄ ФОТО НА ФОНІ: Непрозорість збільшено до 0.22 для кращої видимості */}
      <div className="absolute inset-0 z-0 pointer-events-none opacity-[0.35] blur-[10px] scale-105 select-none transition-opacity duration-1000">
